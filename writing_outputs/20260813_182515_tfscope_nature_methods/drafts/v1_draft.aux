\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Independent foldability.} Boltz-2 complex ipTM for TFScope- ensemble vs DeepPBS consensus DNA ($41$ TFs): $0.957$ vs $0.923$, $32/41$ favor TFScope, Wilcoxon $p=1\times 10^{-5}$. }}{12}{figure.caption.33}\protected@file@percent }
\newlabel{fig:foldability}{{5}{12}{\textbf {Independent foldability.} Boltz-2 complex ipTM for TFScope- ensemble vs DeepPBS consensus DNA ($41$ TFs): $0.957$ vs $0.923$, $32/41$ favor TFScope, Wilcoxon $p=1\times 10^{-5}$}{figure.caption.33}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {DNA-contact residues recognized by TFScope.} PBX1 homeodomain (PDB 1B72): recognition-helix residues scored as DNA-contacting by the frozen- backbone contact probe (AUROC $0.95$) shown as orange sticks with H-bonds to the major-groove bases. }}{13}{figure.caption.34}\protected@file@percent }
\newlabel{fig:recognition}{{6}{13}{\textbf {DNA-contact residues recognized by TFScope.} PBX1 homeodomain (PDB 1B72): recognition-helix residues scored as DNA-contacting by the frozen- backbone contact probe (AUROC $0.95$) shown as orange sticks with H-bonds to the major-groove bases}{figure.caption.34}{}}
